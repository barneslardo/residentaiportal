# ─────────────────────────────────────────────────────────────────────────────
# City of Riverbend — Resident Portal (Okta secures AI demo)
#
# Single public host: https://resident.skylarbarnes.com  → API :3220
# The API serves the built React SPA same-origin, so there is no second CNAME.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Postgres in docker-compose; SIS uses 5437, LMS 5440)
DATABASE_URL=postgresql://resident:resident@localhost:5441/resident_portal

# Public URLs
APP_URL=https://resident.skylarbarnes.com
API_PUBLIC_URL=https://resident.skylarbarnes.com
CORS_ORIGIN=https://resident.skylarbarnes.com
SESSION_COOKIE_DOMAIN=.skylarbarnes.com
TRUST_PROXY=true

SESSION_SECRET=change-me-to-a-long-random-string

API_PORT=3220
NODE_ENV=production

# ── Okta org ────────────────────────────────────────────────────────────────
OKTA_ORG_URL=https://sledai.oktapreview.com
# Management API token (SSWS). Needed only by scripts/setup_okta.py and for the
# groups-claim fallback when the id_token omits `groups`.
OKTA_API_TOKEN=

# ── Municipal custom authorization server (created by scripts/setup_okta.py) ─
# Issuer of the resident.* access tokens the agent and MCP clients present.
OKTA_ISSUER=
RESOURCE_AS_ISSUER=
# Must equal the custom AS audience AND the MCP protected-resource URL.
OKTA_AUDIENCE=https://resident.skylarbarnes.com/mcp
MCP_RESOURCE_URL=https://resident.skylarbarnes.com/mcp

# ── Portal OIDC web app (human sign-in, private_key_jwt) ────────────────────
OKTA_OIDC_CLIENT_ID=
# OKTA_OIDC_CLIENT_SECRET=       # unused when private_key_jwt
OKTA_OIDC_AUTH_METHOD=private_key_jwt
OKTA_OIDC_PRIVATE_KEY_PATH=secrets/app-sign-on-key.json
OKTA_OIDC_REDIRECT_URI=https://resident.skylarbarnes.com/auth/oidc/callback
OIDC_SCOPES=openid profile email groups offline_access

# ── AI agent registration (ID-JAG). MUST differ from OKTA_OIDC_CLIENT_ID ────
AGENT_CLIENT_ID=
OKTA_AGENT_REGISTRATION_ID=
AGENT_PRIVATE_KEY_PATH=secrets/agent-private-key.json
# Hop-1 scope request. Leave blank to request every resident.* scope and let
# Okta policy + the app's persona cap decide what is actually granted.
AGENT_TOKEN_SCOPE=

# ── Embedded agent LLM (xAI Grok is the default; any of the three works) ────
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_DEFAULT_MODEL=grok-4.3

# ── Demo behaviour ──────────────────────────────────────────────────────────
# Allow the no-Okta dev login form (ignored when NODE_ENV=production).
DEV_LOGIN_ENABLED=false
# Payments are simulated. Set to false to let the agent settle a payment without
# a user-confirmed token (not recommended — the confirm step is the demo).
PAYMENTS_REQUIRE_CONFIRMATION=true
